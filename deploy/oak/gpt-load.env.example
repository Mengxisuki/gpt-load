# 仅回环监听，通过SSH隧道或同机NewApi接入，暂不提供公网入口。
HOST=127.0.0.1
PORT=3001
DATA_DIR=/var/lib/gpt-load
# 空连接串使用独立SQLite；不得改成NewApi的数据库。
DATABASE_DSN=
GRACEFUL_SHUTDOWN_TIMEOUT=10
LOG_LEVEL=info
LOG_FORMAT=json
# 管理密钥和加密密钥由应用首次启动生成；不在仓库配置真实值。
AUTH_KEY=
ENCRYPTION_KEY=
# 暂无反代，不信任客户端自报IP；接入Caddy时再配置可信代理。
CLIENT_IP_HEADER=
TRUSTED_PROXIES=
